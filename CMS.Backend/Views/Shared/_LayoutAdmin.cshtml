    Sinh viên: Nguyễn Phi Hùng (2123110475)
    File: Views/Shared/_LayoutAdmin.cshtml
    Chức năng: Khung giao diện Quản trị hoàn chỉnh (Buổi 5 - Ẩn Menu theo Quyền)
========================================================== *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CMS Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .sidebar {
            min-height: 100vh;
            background-color: #2c3e50;
            color: white;
        }

            .sidebar a {
                color: #ecf0f1;
                text-decoration: none;
                display: block;
                padding: 12px 20px;
                font-weight: 500;
                transition: 0.2s;
            }

                .sidebar a:hover {
                    background-color: #34495e;
                    padding-left: 25px;
                }

            .sidebar .active {
                background-color: #3498db;
            }

        .content-area {
            background-color: #f8f9fa;
            min-height: 100vh;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-3 col-lg-2 sidebar p-0 shadow d-flex flex-column">

                <div class="p-4 text-center border-bottom border-secondary">
                    <h4 class="text-white fw-bold m-0"><i class="bi bi-shield-lock"></i> ADMIN PANEL</h4>
                </div>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="p-3 border-bottom border-secondary text-center bg-black bg-opacity-25">
                        <div class="text-warning fw-bold mb-1">
                            <i class="bi bi-person-circle"></i> Xin chào, @User.Identity.Name
                        </div>
                        <div class="small text-light mb-2">
                            Vai trò: @User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value
                        </div>
                        <a asp-controller="Auth" asp-action="Logout" class="btn btn-sm btn-danger w-100 fw-bold">
                            <i class="bi bi-box-arrow-right"></i> ĐĂNG XUẤT
                        </a>
                    </div>
                }

                <div class="mt-3">
                    <a asp-controller="Home" asp-action="Index"><i class="bi bi-house me-2"></i> Xem Website</a>
                    <a asp-controller="Category" asp-action="Index"><i class="bi bi-tags me-2"></i> Quản lý Danh mục</a>
                    <a asp-controller="Post" asp-action="Index"><i class="bi bi-file-text me-2"></i> Quản lý Bài viết</a>

                    @* Nếu vai trò đăng nhập là Admin hoặc Administrator thì mới hiện nút này *@
                    @if (User.IsInRole("Admin") || User.IsInRole("Administrator"))
                    {
                        <a asp-controller="User" asp-action="Index"><i class="bi bi-people me-2"></i> Quản lý Thành viên</a>
                    }
                </div>
            </nav>

            <main class="col-md-9 col-lg-10 ms-sm-auto p-4 content-area">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>