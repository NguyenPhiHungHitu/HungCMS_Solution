@model IEnumerable<CMS.Data.Entities.Category>
@* Họ và tên: Nguyễn Phi Hùng (2123110475) - File: Views/Category/Index.cshtml *@
@{
    ViewData["Title"] = "Quản lý Danh mục";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">Quản Lý Danh Mục</h2>
        <a asp-action="Create" class="btn btn-success">Thêm danh mục mới</a>
    </div>

    <table class="table table-hover table-striped shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Tên danh mục</th>
                <th>Mô tả</th>
                <th class="text-center">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="align-middle fw-bold">@item.Id</td>
                    <td class="align-middle fw-bold text-info">@item.Name</td>
                    <td class="align-middle">@item.Description</td>
                    <td class="align-middle text-center">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a>
                        <a href="/Category/Delete/@item.Id" onclick="return confirm('Bạn có chắc chắn muốn xóa danh mục này?');" class="btn btn-danger btn-sm">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>