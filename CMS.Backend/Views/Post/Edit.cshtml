@model CMS.Data.Entities.Post

@* ==========================================================
    Tên sinh viên: Nguyễn Phi Hùng (2123110475)
    File: Views/Post/Edit.cshtml
    NHẬT KÝ THỰC HÀNH: Giao diện Sửa bài viết (Sử dụng text ImageUrl)
========================================================== *@

@{
    ViewData["Title"] = "Sửa bài viết";
}

<div class="container mt-4 mb-5">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0 fw-bold">Sửa Bài Viết</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedDate" />

                <div asp-validation-summary="All" class="text-danger fw-bold fs-6 mb-3 border border-danger p-2 rounded bg-light" style="display:none;"></div>

                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold">Tiêu đề bài viết</label>
                            <input asp-for="Title" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Content" class="form-label fw-bold">Nội dung</label>
                            <textarea asp-for="Content" class="form-control" rows="12"></textarea>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label fw-bold">Thuộc Danh mục</label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImageUrl" class="form-label fw-bold">Đường dẫn hình ảnh (URL)</label>
                            <input asp-for="ImageUrl" class="form-control" />
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-warning w-100 fw-bold mb-2">Cập nhật thay đổi</button>
                            <a asp-action="Index" class="btn btn-outline-secondary w-100">Hủy bỏ</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
    <script>
        ClassicEditor.create(document.querySelector('#Content')).catch(error => { console.error(error); });

        document.addEventListener("DOMContentLoaded", function () {
            var validationSummary = document.querySelector("[asp-validation-summary]");
            if (validationSummary && validationSummary.innerText.trim() !== "") {
                validationSummary.style.display = "block";
            }
        });
    </script>
}