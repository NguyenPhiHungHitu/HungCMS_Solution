@model CMS.Backend.Controllers.PostViewModel
@* ==========================================================
    Sinh viên: Nguyễn Phi Hùng (2123110475)
    Chức năng: Giao diện Thêm bài viết mới (Hỗ trợ tải ảnh từ Laptop)
========================================================== *@

@{
    ViewData["Title"] = "Thêm bài viết";
}

<div class="container mt-4 mb-5">
    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0 fw-bold">Thêm Bài Viết Mới</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="text-danger fw-bold fs-6 mb-3 border border-danger p-2 rounded bg-light"></div>
                }

                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold">Tiêu đề bài viết</label>
                            <input asp-for="Title" class="form-control" required placeholder="Nhập tiêu đề tại đây..." />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Content" class="form-label fw-bold">Nội dung bài viết</label>
                            <textarea asp-for="Content" class="form-control" rows="12"></textarea>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label fw-bold">Thuộc Danh mục</label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImageUpload" class="form-label fw-bold">Chọn hình ảnh từ máy tính</label>
                            <input asp-for="ImageUpload" type="file" class="form-control" accept="image/*" />
                            <span asp-validation-for="ImageUpload" class="text-danger"></span>
                            <div class="form-text text-muted">Hỗ trợ các định dạng ảnh: .jpg, .jpeg, .png, .gif. Nếu không chọn, hệ thống sẽ sử dụng ảnh mặc định.</div>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-success w-100 mb-2 fw-bold">
                                <i class="bi bi-plus-circle"></i> Đăng bài viết
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary w-100">Hủy bỏ</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
    <script>
        ClassicEditor.create(document.querySelector('#Content')).catch(error => { console.error(error); });
    </script>
}