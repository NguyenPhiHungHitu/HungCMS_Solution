@model CMS.Data.Entities.Post
@* Họ và tên: Nguyễn Phi Hùng (2123110475) - File: Views/Post/Details.cshtml *@
@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <h1 class="display-4 fw-bold text-primary mb-3">@Model.Title</h1>

            <div class="mb-4 text-muted">
                <span>Đăng ngày: @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span> |
                <span class="badge bg-info text-dark">@(Model.Category?.Name ?? "Chưa phân loại")</span>
            </div>

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="text-center mb-4">
                    <img src="@Model.ImageUrl" class="img-fluid rounded" style="max-height: 500px; width: 100%; object-fit: cover;">
                </div>
            }

            <div class="fs-5" style="white-space: pre-line;">
                @Html.Raw(Model.Content)
            </div>

            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại trang chủ
            </a>
        </div>
    </div>
</div>