@model CMS.Data.Entities.Product
@{
    ViewData["Title"] = "Xóa sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-danger"><i class="bi bi-trash"></i> XÓA SẢN PHẨM</h2>
</div>

<div class="card shadow border-0 border-top border-danger border-3 p-4 col-md-6">
    <h4 class="text-danger mb-4">Bạn có chắc chắn muốn xóa sản phẩm này không?</h4>
    <dl class="row">
        <dt class="col-sm-4">Tên sản phẩm</dt>
        <dd class="col-sm-8 fw-bold">@Model.Name</dd>

        <dt class="col-sm-4">Giá bán</dt>
        <dd class="col-sm-8 text-danger fw-bold">@Model.Price.ToString("#,##0") đ</dd>

        <dt class="col-sm-4">Tồn kho</dt>
        <dd class="col-sm-8">@Model.StockQuantity</dd>

        <dt class="col-sm-4">Danh mục</dt>
        <dd class="col-sm-8">@Model.CategoryProduct?.Name</dd>
    </dl>

    <div class="mt-4 border-top pt-3">
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger px-4 fw-bold"><i class="bi bi-trash"></i> Xác nhận xóa</button>
            <a asp-action="Index" class="btn btn-secondary px-4 fw-bold">Hủy bỏ</a>
        </form>
    </div>
</div>