@model IEnumerable<CMS.Data.Entities.User>

@{
    ViewData["Title"] = "Quản lý Người dùng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">Quản Lý Danh Sách Người Dùng</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-person-plus"></i> Thêm người dùng mới
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 10%;" class="ps-3">ID</th>
                        <th style="width: 20%;">Tài khoản (Username)</th>
                        <th style="width: 30%;">Họ và tên (FullName)</th>
                        <th style="width: 20%;">Phân quyền (Role)</th>
                        <th style="width: 20%;" class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold ps-3 align-middle">@item.Id</td>
                                <td class="align-middle fw-bold text-dark">@item.Username</td>
                                <td class="align-middle">@item.FullName</td>
                                <td class="align-middle">
                                    @if (item.Role == "Quản trị viên")
                                    {
                                        <span class="badge bg-danger">@item.Role</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark">@item.Role</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm me-1">
                                        Sửa
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                        Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                Chưa có người dùng nào trong cơ sở dữ liệu. Vui lòng bấm thêm mới!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>