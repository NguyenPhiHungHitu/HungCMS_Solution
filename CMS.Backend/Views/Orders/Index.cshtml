@model IEnumerable<CMS.Data.Entities.Order>
@{
    ViewData["Title"] = "Quản lý Đơn hàng";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-uppercase font-weight-bold text-light">
            <i class="fas fa-box-open mr-2"></i> QUẢN LÝ ĐƠN HÀNG
        </h3>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle border-0" style="background-color: #1a1d24;">
            <thead style="background-color: #2c313c;">
                <tr>
                    <th scope="col">Mã ĐH</th>
                    <th scope="col">Ngày đặt</th>
                    <th scope="col">Khách hàng</th>
                    <th scope="col">Trạng thái</th>
                    <th scope="col" class="text-center">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr style="border-bottom: 1px solid #2c313c;">
                        <td class="font-weight-bold">#@item.Id</td>
                        <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>

                        <td>@(item.Customer?.Id.ToString() ?? "Khách vãng lai")</td>

                        <td>
                            @if (item.Status == 0)
                            {
                                <span class="badge badge-warning px-2 py-1">Chờ duyệt</span>
                            }
                            else if (item.Status == 1)
                            {
                                <span class="badge badge-info px-2 py-1">Đang giao</span>
                            }
                            else
                            {
                                <span class="badge badge-success px-2 py-1">Đã xong</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary font-weight-bold">
                                <i class="fas fa-eye mr-1"></i> Xem chi tiết
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>