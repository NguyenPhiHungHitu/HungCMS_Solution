@model CMS.Data.Entities.Banner

@* ==========================================================
    Tên sinh viên: Nguyễn Phi Hùng (2123110475)
    File: Views/Banner/Delete.cshtml
    Chức năng: Giao diện xác nhận xóa banner
========================================================== *@

@{
    ViewData["Title"] = "Xóa banner";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Xác Nhận Xóa Banner</h4>
                </div>

                <div class="card-body">
                    <div class="alert alert-warning mb-4">
                        <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa banner dưới đây không? Hành động này sẽ xóa dữ liệu vĩnh viễn khỏi hệ thống!
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-7">
                            <h4 class="text-primary fw-bold">@Model.Title</h4>
                            @if (!string.IsNullOrEmpty(Model.Subtitle))
                            {
                                <p class="text-muted">@Model.Subtitle</p>
                            }
                            <p class="text-muted mb-2">
                                <i class="bi bi-calendar3"></i> Ngày tạo: @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                            </p>
                            <p>
                                <i class="bi bi-sort-numeric-up"></i> Thứ tự: <span class="badge bg-secondary">@Model.SortOrder</span>
                            </p>
                            <p>
                                Trạng thái:
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">Đang hiện</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Đã ẩn</span>
                                }
                            </p>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="col-md-5 text-center">
                                <img src="@Model.ImageUrl" alt="Banner preview" class="img-thumbnail shadow-sm" style="max-height: 150px; max-width: 100%; object-fit: cover;" />
                            </div>
                        }
                    </div>

                    <hr />

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                Quay lại danh sách
                            </a>
                            <button type="submit" class="btn btn-danger fw-bold px-4">
                                <i class="bi bi-trash"></i> Vâng, Xóa banner này!
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
