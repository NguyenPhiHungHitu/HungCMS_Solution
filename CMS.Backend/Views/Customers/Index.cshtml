@model IEnumerable<CMS.Data.Entities.Customer>
@{
    ViewData["Title"] = "Quản lý Khách hàng";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-uppercase font-weight-bold text-light">
            <i class="fas fa-users mr-2"></i> QUẢN LÝ KHÁCH HÀNG
        </h3>
    </div>

    <div class="table-responsive shadow-sm">
        <table class="table table-dark table-hover align-middle border-0" style="background-color: #1a1d24;">
            <thead style="background-color: #2c313c;">
                <tr>
                    <th scope="col" width="5%">ID</th>
                    <th scope="col" width="20%">Họ và tên</th>
                    <th scope="col" width="20%">Email</th>
                    <th scope="col" width="15%">Số điện thoại</th>
                    <th scope="col" width="25%">Địa chỉ giao hàng</th>
                    <th scope="col" width="15%" class="text-center">Số đơn đã đặt</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr style="border-bottom: 1px solid #2c313c;">
                            <td class="font-weight-bold text-muted">#@item.Id</td>
                            <td class="font-weight-bold text-info">@item.FullName</td>
                            <td>@item.Email</td>
                            <td>@(string.IsNullOrEmpty(item.Phone) ? "Chưa cập nhật" : item.Phone)</td>
                            <td>
                                <span class="text-truncate d-inline-block" style="max-width: 250px;" title="@item.Address">
                                    @(string.IsNullOrEmpty(item.Address) ? "Chưa cập nhật" : item.Address)
                                </span>
                            </td>
                            <td class="text-center">
                                @if (item.Orders != null && item.Orders.Count > 0)
                                {
                                    <span class="badge badge-success px-3 py-2" style="font-size: 13px;">
                                        <i class="fas fa-shopping-bag mr-1"></i> @item.Orders.Count đơn
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary px-2 py-1">Chưa mua hàng</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            Chưa có khách hàng nào đăng ký trên hệ thống.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>